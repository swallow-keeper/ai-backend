{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swallow-guardian.local/ws/resync.json",
  "title": "RESYNC",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "session_id", "phase"],
  "properties": {
    "type": { "const": "RESYNC" },
    "session_id": { "type": "string" },
    "phase": {
      "enum": ["TRACKING", "CANDIDATE", "AWAITING_VOICE", "ANALYZING", "RESULT", "RECHECK", "ALERT", "AWAITING_RESOLVE"]
    },
    "last_event_id": { "type": ["string", "null"] },
    "open_event_id": { "type": ["string", "null"] }
  }
}
